{
  "description": "Simplifies managing arisan groups and rotating savings contributions",
  "secrets": [],
  "tests": [
    {
      "id": "beranda.default",
      "name": "Beranda renders",
      "path": "/",
      "expectText": "Arisan Keluarga Besar",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "id": "detail.status",
      "name": "Detail arisan renders with the turn circle and status tab",
      "path": "/arisan/demo-kb",
      "expectText": "Awaiting confirmation",
      "expectSelector": "#lingkaran-giliran",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "Turn circle centre text (English default)",
      "path": "/arisan/demo-kb",
      "expectText": "Turn 4 of 10"
    },
    {
      "name": "Indonesian renders on Beranda",
      "path": "/?lang=id",
      "expectText": "Arisan Anda"
    },
    {
      "name": "Indonesian renders on Detail arisan",
      "path": "/arisan/demo-kb?lang=id",
      "expectText": "Menunggu konfirmasi"
    },
    {
      "name": "Language picker present",
      "path": "/",
      "expectSelector": "#language-select"
    },
    {
      "id": "revisi.workshop",
      "name": "Quick revision workshop renders with preview, checklist and history",
      "path": "/revisi.html",
      "expectText": "Preview",
      "expectSelector": "#revisi-checklist",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "Workshop renders in Indonesian",
      "path": "/revisi.html?lang=id",
      "expectText": "Pratinjau"
    },
    {
      "name": "Revision tools link under the Beranda demo note",
      "path": "/",
      "expectSelector": "#link-revisi"
    },
    {
      "name": "Detail arisan via the hash route (workshop preview)",
      "path": "/index.html#/arisan/demo-kb",
      "expectSelector": "#lingkaran-giliran"
    }
  ]
}
